# Prebuilt Power Tool, including Electron and all packaged dependencies/resources.
/power-tool/app/
node_modules/

# Local integration files. Keep the shared catalog and server definitions.
/integrations/*
!/integrations/mapping.json
!/integrations/wpilib.json

# WPILib / Gradle output. Keep the project's Gradle wrapper in version control.
.gradle/
/build/
/bin/
/out/
*.class
*.jar
!gradle-wrapper.jar
*.exe
*.dll
*.so
*.dylib
*.zip
hs_err_pid*
.classpath
.project
.settings/
.factorypath
.gradletasknamecache
gradle-app.setting

# IDE and OS files.
.idea/
*.iml
*.ipr
*.iws
.fleet/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini

# Log files in any folder.
*.log
*.wpilog
*.wpilog.part
*.hoot
*.hoot.part
*.rlog
*.dslog
*.dsevents
*.jfr

# Keep the release README and ignore everything else in local log folders.
logs/
!/logs/
/logs/*
!/logs/README.md

# Local simulation state.
networktables.json
simgui.json
*-window.json
ctre_sim/
/.cache/
compile_commands.json
